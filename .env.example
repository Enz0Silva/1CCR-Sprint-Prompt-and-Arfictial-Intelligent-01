# ================================================
# ChargeGrid AI — Variaveis de ambiente (Sprint 03)
# ================================================

# O .env esta no .gitignore. NUNCA commite este arquivo preenchido.
# Se uma chave vazar no historico do Git, revogue e gere outra — nao basta


# --- Ollama Cloud

OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=coloque_sua_chave_aqui

# --- Modelos ---
# Chain principal. O enunciado pede gpt-oss:120b
# Segundo modelo do comparativo obrigatorio (§6).
# Mesma familia, 6x menor: isola o efeito do tamanho do modelo.

OLLAMA_MODEL=gpt-oss:120b
OLLAMA_MODEL_2=gpt-oss:20b

# --- Comportamento ---
PROMPT_VERSAO=v3
MAX_TOKENS_HISTORICO=800

# --- Bonus multi-provider (opcional) ---
# Sem estas chaves, as celulas correspondentes da matriz sao puladas com aviso.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=